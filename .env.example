# Kopiér til .env og ret.
PUBLIC_URL=http://localhost:8000
PORT=8000

POSTGRES_DB=portal
POSTGRES_USER=portal
POSTGRES_PASSWORD=skift-mig

# Superadmin: denne obserkode får rollen ved opstart og logger ind med sin DOFbasen-adgangskode
SUPERADMIN_OBSERKODE=

# Mappe med månedsudtræk dofbasen_ÅÅÅÅ_MM.csv (importeres automatisk ved opstart)
DOF_ARCHIVE_DIR=./data/archive

# DOFbasen: mindst 60 sekunder mellem kald. Sæt DOF_ENABLED=false for at slå alle kald fra.
DOF_MIN_INTERVAL=60
DOF_ENABLED=true

# Sæt til true bag HTTPS (påkrævet for push-notifikationer på andre end localhost)
COOKIE_SECURE=false
VAPID_SUBJECT=mailto:admin@example.org

# Push til Android-appen via Firebase: servicekontoens JSON på én linje, eller base64 (base64 -w0 nøgle.json).
# Se app/README.md. Uden dette virker kun Web Push i browseren.
FCM_SERVICE_ACCOUNT_B64=

# Opdelte databaser (valgfrit): brugerdata og observationer på hver sin gruppe af Postgres-noder, styret fra db-admin
# (http://localhost:8100, kun superadmin). Tom DBADMIN_URL = én samlet database (POSTGRES_*). Se README → Databaser.
DBADMIN_URL=
DBADMIN_SERVICE_TOKEN=
DBADMIN_PORT=8100
