  apisvc -> anyweb [label="75 HTTP(S)", color="#1f5fa8", fontcolor="#1f5fa8", style=solid];
  apisvc -> xc [label="76 HTTPS", color="#1f5fa8", fontcolor="#1f5fa8", style=solid];
  wpush -> fcm [label="77 HTTPS", color="#1f5fa8", fontcolor="#1f5fa8", style=solid];
  apisvc -> fcm [label="78 HTTPS", color="#1f5fa8", fontcolor="#1f5fa8", style=solid];
  wpush -> wps [label="79 HTTPS", color="#1f5fa8", fontcolor="#1f5fa8", style=solid];
  apisvc -> wps [label="80 HTTPS", color="#1f5fa8", fontcolor="#1f5fa8", style=solid];
  fcm -> pushrx [label="81 push", color="#1f5fa8", fontcolor="#1f5fa8", style=dashed, constraint=false];
  wps -> sw [label="82 push", color="#1f5fa8", fontcolor="#1f5fa8", style=dashed, constraint=false];
  leaf -> osm [label="83 HTTPS", color="#1f5fa8", fontcolor="#1f5fa8", style=solid, constraint=false];
  spa -> dofb [label="84 HTTPS", color="#1f5fa8", fontcolor="#1f5fa8", style=solid, constraint=false];
}